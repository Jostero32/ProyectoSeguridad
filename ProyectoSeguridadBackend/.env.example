# ════════════════════════════════════════════════════════════════════
#  ProyectoSeguridad – Backend – Plantilla de variables de entorno
#  Copia este archivo como ".env" y rellena los valores reales.
#  Este archivo SÍ se sube al repo (sin secretos reales).
# ════════════════════════════════════════════════════════════════════

# ─── Capa 1: Cifrado de base de datos (AES-GCM, solo backend) ────
# Opciones: AES_GCM | DES_CBC | CHACHA20_POLY1305
# Longitud de clave: AES_GCM → 32 bytes | DES_CBC → 8 bytes | CHACHA20_POLY1305 → 32 bytes
MESSENGER_DB_CRYPTO_ALGORITHM=AES_GCM
MESSENGER_DB_CRYPTO_SECRET=<clave-32-bytes-para-AES-GCM>

# ─── Capa 2: Cifrado back ↔ front REST (DES-CBC) ─────────────────
# Opciones: AES_GCM | DES_CBC | CHACHA20
# Longitud de clave: DES_CBC → 8 bytes exactos
# DEBE coincidir con NG_APP_API_CRYPTO_* en el .env del frontend
MESSENGER_API_CRYPTO_ALGORITHM=DES_CBC
MESSENGER_API_CRYPTO_SECRET=<clave-8-bytes-DES>

# ─── Capa 3: Cifrado WebSocket STOMP (ChaCha20) ──────────────────
# Opciones: AES_GCM | DES_CBC | CHACHA20
# Longitud de clave: CHACHA20 → 32 bytes exactos
# DEBE coincidir con NG_APP_WS_CRYPTO_* en el .env del frontend
MESSENGER_WS_CRYPTO_ALGORITHM=CHACHA20
MESSENGER_WS_CRYPTO_SECRET=<clave-32-bytes-para-ChaCha20>

# ─── Base de datos PostgreSQL ─────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/messenger_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<password-postgres>

# ─── MinIO (almacenamiento de objetos) ───────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=<minio-access-key>
STORAGE_SECRET_KEY=<minio-secret-key>
STORAGE_BUCKET=messenger-archivos
STORAGE_BUCKET_AVATARS=messenger-avatars

# ─── Correo (Gmail SMTP) ──────────────────────────────────────────
# Para Gmail: activa "Verificación en 2 pasos" y genera una "Contraseña de aplicación"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<tu-cuenta@gmail.com>
MAIL_PASSWORD=<contraseña-de-aplicacion-gmail-16-chars>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ─── URL de restablecimiento de contraseña ────────────────────────
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/auth/restablecer-password
PASSWORD_RESET_EXPIRY_MINUTES=15
