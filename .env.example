# ════════════════════════════════════════════════════════════════════
#  ProyectoSeguridad – Plantilla de variables de entorno
#  Copia este archivo como ".env" y rellena los valores reales.
#  Este archivo SÍ se puede subir al repo (sin secretos reales).
# ════════════════════════════════════════════════════════════════════

# ─── Capa 1: Cifrado de base de datos (AES-GCM, solo backend) ────
# Opciones: AES_GCM | DES_CBC | CHACHA20_POLY1305
# Longitud de clave → AES_GCM: 32 bytes | DES_CBC: 8 bytes | CHACHA20_POLY1305: 32 bytes
MESSENGER_DB_CRYPTO_ALGORITHM=AES_GCM
MESSENGER_DB_CRYPTO_SECRET=<clave-32-bytes-para-AES-GCM>

# ─── Capa 2: Cifrado back↔front REST (DES-CBC) ───────────────────
# Clave compartida: debe coincidir en backend y frontend
# Opciones: AES_GCM | DES_CBC | CHACHA20
# Longitud de clave → DES_CBC: 8 bytes exactos
MESSENGER_API_CRYPTO_ALGORITHM=DES_CBC
MESSENGER_API_CRYPTO_SECRET=<clave-8-bytes-DES>

# ─── Capa 3: Cifrado WebSocket STOMP (ChaCha20) ──────────────────
# Clave compartida: debe coincidir en backend y frontend
# Opciones: AES_GCM | DES_CBC | CHACHA20
# Longitud de clave → CHACHA20: 32 bytes exactos
MESSENGER_WS_CRYPTO_ALGORITHM=CHACHA20
MESSENGER_WS_CRYPTO_SECRET=<clave-32-bytes-para-ChaCha20>

# ─── Base de datos PostgreSQL ─────────────────────────────────────
POSTGRES_PASSWORD=<password-postgres>

# ─── MinIO (almacenamiento de objetos) ───────────────────────────
MINIO_ROOT_USER=<minio-user>
MINIO_ROOT_PASSWORD=<minio-password>

# ─── Correo (Gmail SMTP) ──────────────────────────────────────────
# Para Gmail: activa "Verificación en 2 pasos" → genera "Contraseña de aplicación"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<tu-cuenta@gmail.com>
MAIL_PASSWORD=<contraseña-de-aplicacion-gmail-16-chars>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ─── Reset de contraseña ──────────────────────────────────────────
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/auth/restablecer-password
PASSWORD_RESET_EXPIRY_MINUTES=15
