# ════════════════════════════════════════════════════════════════════
#  ProyectoSeguridad – Frontend – Plantilla de variables de entorno
#  Copia este archivo como ".env" y rellena los valores reales.
#  Este archivo SÍ se sube al repo (sin secretos reales).
#
#  Angular (v17+) carga automáticamente este archivo.
#  Solo las variables con prefijo NG_APP_ quedan disponibles en el
#  código como: import.meta.env['NG_APP_NOMBRE_VARIABLE']
# ════════════════════════════════════════════════════════════════════

# ─── URLs del backend ─────────────────────────────────────────────
NG_APP_API_BASE_URL=http://localhost:8080
NG_APP_WS_URL=ws://localhost:8080/ws
NG_APP_SOCK_JS_URL=http://localhost:8080/ws

# ─── Capa 2: Cifrado back ↔ front REST (DES-CBC) ─────────────────
# DEBE coincidir con MESSENGER_API_CRYPTO_* en el .env del backend
# Opciones de algoritmo: AES_GCM | DES_CBC | CHACHA20
# ADVERTENCIA: esta clave queda embebida en el bundle JS del cliente.
NG_APP_API_CRYPTO_ALGORITHM=DES_CBC
NG_APP_API_CRYPTO_SECRET=<clave-8-bytes-DES>

# ─── Capa 3: Cifrado WebSocket STOMP (ChaCha20) ──────────────────
# DEBE coincidir con MESSENGER_WS_CRYPTO_* en el .env del backend
# Opciones de algoritmo: AES_GCM | DES_CBC | CHACHA20
# ADVERTENCIA: esta clave queda embebida en el bundle JS del cliente.
NG_APP_WS_CRYPTO_ALGORITHM=CHACHA20
NG_APP_WS_CRYPTO_SECRET=<clave-32-bytes-para-ChaCha20>
