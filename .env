# ════════════════════════════════════════════════════════════════════
#  ProyectoSeguridad – Variables de entorno del stack completo
#  ¡NO SUBIR AL REPOSITORIO!
# ════════════════════════════════════════════════════════════════════

# ─── Capa 1: Cifrado de base de datos (AES-GCM, solo backend) ────
MESSENGER_DB_CRYPTO_ALGORITHM=AES_GCM
MESSENGER_DB_CRYPTO_SECRET=CambiaEsto_AES256GCM_32ByteSecret!

# ─── Capa 2: Cifrado back↔front REST (DES-CBC) ───────────────────
# Clave compartida: debe ser igual en backend y frontend
# DES requiere exactamente 8 bytes
MESSENGER_API_CRYPTO_ALGORITHM=DES_CBC
MESSENGER_API_CRYPTO_SECRET=Secr3t8!

# ─── Capa 3: Cifrado WebSocket STOMP (ChaCha20) ──────────────────
# Clave compartida: debe ser igual en backend y frontend
# ChaCha20 requiere exactamente 32 bytes
MESSENGER_WS_CRYPTO_ALGORITHM=CHACHA20
MESSENGER_WS_CRYPTO_SECRET=CambiaEsto_ChaCha20Poly_32ByteKey

# ─── Base de datos PostgreSQL ─────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ─── MinIO (almacenamiento de objetos) ───────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Correo (Gmail SMTP) ──────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ─── Reset de contraseña ──────────────────────────────────────────
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/auth/restablecer-password
PASSWORD_RESET_EXPIRY_MINUTES=15
